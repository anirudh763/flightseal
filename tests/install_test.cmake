# Installs the build into a temporary prefix, then checks the installed fseal verifies the shipped samples exactly
# as the fseal in the build tree does.
#   cmake -DBUILD_DIR=build -DSOURCE_DIR=. -P tests/install_test.cmake
if(NOT BUILD_DIR OR NOT SOURCE_DIR)
  message(FATAL_ERROR "pass -DBUILD_DIR=... -DSOURCE_DIR=...")
endif()
set(prefix "${BUILD_DIR}/install-test")
file(REMOVE_RECURSE "${prefix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${prefix}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "cmake --install failed (${rc})")
endif()
set(installed "${prefix}/bin/fseal")
if(NOT EXISTS "${installed}")
  message(FATAL_ERROR "cmake --install did not install bin/fseal")
endif()

set(samples "${SOURCE_DIR}/docs/samples")
file(READ "${samples}/pubkey.txt" pub)
string(STRIP "${pub}" pub)
# Each case: the log, whether to pass the receipts, and the exit status both binaries must give.
foreach(case "intact.fseal;0;0" "intact.fseal;1;0" "tampered.fseal;0;1" "rewritten.fseal;0;0" "rewritten.fseal;1;1")
  list(GET case 0 log)
  list(GET case 1 with_receipts)
  list(GET case 2 want)
  set(args verify "${samples}/${log}")
  if(with_receipts)
    list(APPEND args --receipts "${samples}/flight.receipts" --pubkey "${pub}")
  endif()
  execute_process(COMMAND "${BUILD_DIR}/fseal" ${args} RESULT_VARIABLE rc_build OUTPUT_VARIABLE out_build)
  execute_process(COMMAND "${installed}" ${args} RESULT_VARIABLE rc_inst OUTPUT_VARIABLE out_inst)
  if(NOT rc_build EQUAL want OR NOT rc_inst EQUAL want)
    message(FATAL_ERROR "${log} (receipts: ${with_receipts}): exit ${rc_build} from the build tree, ${rc_inst} installed, want ${want}")
  endif()
  if(NOT out_build STREQUAL out_inst)
    message(FATAL_ERROR "${log}: installed fseal printed\n${out_inst}\nbut the build tree printed\n${out_build}")
  endif()
endforeach()
string(FIND "${out_inst}" "RESULT: TAMPERED" found)
if(found EQUAL -1)
  message(FATAL_ERROR "last case should be TAMPERED")
endif()
file(REMOVE_RECURSE "${prefix}")
message(STATUS "installed fseal verifies the samples as the build tree does")
